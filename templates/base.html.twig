<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}FixFire: {% endblock %}</title>
        <link rel="icon" type="image/svg+xml"
              href='data:image/svg+xml,
                   <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                       <path d="M8 5C7 4.5 6 4.5 5 5.3 3.5 6.4 3 8.3 3 10.5s.5 4.1 2 5.2C6.2 16.8 7.2 17 8 16.8
                           M16 5c1-0.5 2-0.5 3 .3 1.5 1.1 2 3 2 5.2s-.5 4.1-2 5.2c-1.2 1-2.2 1.2-3 .9
                           M8 5c1-.7 2-1 4-1s3 .3 4 1"
                           fill="%23f97316" stroke="%23ea580c" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                       <path d="M12 3v-1.2c0-.5.4-.8.9-.7l1 .2" fill="none" stroke="%23065f46" stroke-width="1.2" stroke-linecap="round"/>
                       <path d="M9 11l-1.3 1.2L9 13.4" fill="%23facc15" stroke="%23000000" stroke-width="0.8" stroke-linejoin="round"/>
                       <path d="M15 11l1.3 1.2L15 13.4" fill="%23facc15" stroke="%23000000" stroke-width="0.8" stroke-linejoin="round"/>
                       <path d="M8.5 15c1 .8 2 .8 3 .8s2 0 3-.8" fill="none" stroke="%23000000" stroke-width="0.9" stroke-linecap="round"/>
                   </svg>'>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="text-[#8B0000]" style="background: radial-gradient(102.21% 102.21% at 50% 28.75%, #000000 42.62%, #8B0000 100%);">
    <div class="flex flex-col justify-between min-h-screen relative">
            <div>
                <header class="h-[114px] shrink-0 flex flex-col sm:flex-row items-center sm:justify-between py-4 sm:py-0 px-6 border-b border-white/20 shadow-md">
                    <a href="{{ path('app_mainMenu') }}">
                        <img src="{{ asset('images/logo_fox.png') }}" alt="Fox_Logo">
                    </a>
                    <nav class="flex space-x-4 font-semibold text-white">
                        <a class="hover:text-amber-400 pt-2" href="{{ path('app_mainMenu') }}">
                            Main menu
                        </a>
                        <a class="hover:text-amber-400  pt-2" href="{{ path('app_contact_aboutMe') }}">
                            About me
                        </a>
                        <a class="hover:text-amber-400  pt-2" href="{{ path('app_cooking_recipe') }}">
                            Cooking Recipes
                        </a>
                    </nav>
                </header>
                {% block body %}{% endblock %}
            </div>
            <div class="p-5 bg-white/5 mt-3 text-center text-white">
                Made with fluffy paws by FoxFire
            </div>
        </div>
    </body>
</html>
