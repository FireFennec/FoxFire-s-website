
{{ form_start(form) }}

<div class="recipe-form-field">
    {{ form_label(form.recipe_name, 'Recipe name') }}
    {{ form_widget(form.recipe_name) }}
    {{ form_errors(form.recipe_name) }}
</div>

<div class="recipe-form-field">
    {{ form_label(form.ingredience, 'Ingredients') }}

    <div
        id="ingredients-list"
        class="recipe-ingredients-list"
        data-index="{{ form.ingredience|length }}"
        data-prototype="{{ form_widget(form.ingredience.vars.prototype)|e('html_attr') }}"
    >
        {% for ingredient in form.ingredience %}
            <div class="ingredient-item">
                {{ form_widget(ingredient) }}

                <button type="button" class="remove-ingredient">
                    X
                </button>
            </div>
        {% endfor %}
    </div>

    {{ form_errors(form.ingredience) }}

    <button
        type="button"
        id="add-ingredient"
        class="recipe-add-ingredient"
    >
        + Add ingredient
    </button>
</div>

<div class="recipe-form-field">
    {{ form_label(form.cooking_process, 'Cooking process') }}
    {{ form_widget(form.cooking_process) }}
    {{ form_errors(form.cooking_process) }}
</div>

<div class="recipe-form-actions">
    {{ form_widget(form.submit, {
        label: submitLabel,
        attr: {
            class: 'button'
        }
    }) }}
</div>

{{ form_end(form, {'render_rest': false}) }}
