{% extends 'base.html.twig' %}

{% block title %}Create cooking recipe{% endblock %}

{% block body %}
    <div class="recipe-form-page">

        <a
            class="button recipe-form-back"
            href="{{ path('app_cooking_recipe') }}"
        >
            Back
        </a>

        <div class="recipe-form-content">
            <section class="recipe-form-panel">
                <h1>Create Recipe</h1>

                {% include 'cookingRecipe/_recipeForm.html.twig' with {
                    submitLabel: 'Create Recipe'
                } %}
            </section>
        </div>

    </div>

    {% include 'cookingRecipe/_ingredientsScript.html.twig' %}
{% endblock %}
