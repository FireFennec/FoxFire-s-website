{% extends 'base.html.twig' %}

{% block title %}List of Recipes{% endblock %}

{% block body %}
    <div>
        <a href="{{ path('app_cooking_recipe_create') }}">
            Create Recipe
        </a>

        <div>
            <h1>Cooking recipes</h1>

            <table>
                {% for recipe in recipes %}
                    <tr>
                        <th>
                            <a href="{{ path('app_cooking_recipe_showRecipeInfo', {id: recipe.id}) }}">
                                {{ recipe.recipeName }}
                            </a>
                        </th>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
