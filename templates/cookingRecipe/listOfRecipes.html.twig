{% extends 'base.html.twig' %}

{% block title %}List of Recipes{% endblock %}

{% block body %}
    <div class="relative flex flex-col items-center justify-start pt-15 p-8 text-white">
        <a class="absolute left-15 top-15 px-12 py-5 bg-white/10 backdrop-blur-sm border-2 border-white/30
           rounded-lg text-white text-2xl font-bold hover:bg-white/20 hover:border-white/50
           hover:scale-105 hover:shadow-xl transition-all duration-300 whitespace-nowrap"
           href="{{ path('app_cooking_recipe_create') }}">
            Create Recipe
        </a>

        <div class="w-full max-w-3xl border-4 border-white rounded-lg p-8">
            <h1 class="text-4xl text-white mb-8 text-center">Cooking recipes</h1>

            <table class="w-full text-white mb-8 border-separate border-spacing-y-3">
                {% for recipe in recipes %}
                    <tr>
                        <th>
                            <a class="ml-4 inline-block px-6 py-3 bg-white/10 backdrop-blur-sm border-2 border-white/30
                               text-white text-lg font-bold hover:bg-white/20 hover:border-white/50
                               hover:scale-105 hover:shadow-xl transition-all duration-300 whitespace-nowrap"
                               href="{{ path('app_cooking_recipe_showRecipeInfo', {id: recipe.id}) }}">
                                {{ recipe.recipeName }}
                            </a>
                        </th>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
