{% extends 'base.html.twig' %}

{% block title %}List of Recipes{% endblock %}

{% block body %}
    <div class="page-layout recipes-page">
        <a
            class="button page-action"
            href="{{ path('app_cooking_recipe_create') }}"
        >
            + Create Recipe
        </a>

        <div class="page-content page-width-800">
            <section class="page-panel page-panel-compact recipes-section">
                <h1>Cooking recipes</h1>

                <div class="recipes-list">
                    {% for recipe in recipes %}
                        <div class="recipe-row">
                            <a
                                class="recipe-name"
                                href="{{ path('app_cooking_recipe_showRecipeInfo', {id: recipe.id}) }}"
                            >
                                {{ recipe.recipeName }}
                            </a>
                        </div>
                    {% else %}
                        <p class="recipes-empty">
                            No recipes have been added yet.
                        </p>
                    {% endfor %}
                </div>
            </section>
        </div>
    </div>
{% endblock %}
