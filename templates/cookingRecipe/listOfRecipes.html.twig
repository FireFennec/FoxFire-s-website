{% extends 'base.html.twig' %}

{% block title %}List of Recipes{% endblock %}

{% block body %}
    <div class="flex flex-col items-center justify-start pt-15 p-8 text-white">
        <div class="w-full max-w-2xl border-4 border-white rounded-lg p-8">
            <h1 class="text-4xl text-white mb-8 text-center">Cooking recipes</h1>

            <table class="w-full text-white mb-8">
                {% for recipe in recipes %}
                    <tr>
                        <th colspan="2" class="text-2xl text-white pb-2">{{ recipe.recipeName }}</th>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
