{% extends 'base.html.twig' %}

{% block title %}Recipe - {{ cookingRecipe.recipeName }}{% endblock %}

{% block body %}
    <div class="page-layout recipe-detail-page">
        <a
            class="button page-action"
            href="{{ path('app_cooking_recipe') }}"
        >
            Back
        </a>

        <div class="page-content page-width-900">
            <section class="page-panel page-panel-standard">

                <div class="recipe-detail-header">
                    <h1>{{ cookingRecipe.recipeName }}</h1>

                    {% if is_granted('ROLE_COOKING_ADMIN') %}
                        <a
                            class="button-edit"
                            href="{{ path('app_cookingRecipe_editCookingRecipe', {id: cookingRecipe.id}) }}"
                        >
                            Update Recipe
                        </a>
                    {% endif %}
                </div>

                <section class="recipe-detail-section">
                    <h2>Ingredients</h2>

                    <ul class="recipe-ingredients">
                        {% for ingredient in cookingRecipe.ingredients %}
                            <li>{{ ingredient }}</li>
                        {% endfor %}
                    </ul>
                </section>

                <section class="recipe-detail-section">
                    <h2>Cooking process</h2>

                    <p class="recipe-process">
                        {{ cookingRecipe.cookingProcess }}
                    </p>
                </section>

            </section>
        </div>

    </div>
{% endblock %}
