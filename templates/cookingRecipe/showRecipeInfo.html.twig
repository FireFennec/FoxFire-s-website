{% extends 'base.html.twig' %}

{% block title %}Recipe - cooking.recipeName{% endblock %}

{% block body %}
    <div class="text-white flex flex-col items-center text-center min-h-screen my-6">

        <div class="relative w-full flex justify-center items-center mb-6">

            <a class="absolute left-10 px-8 py-4 bg-white/10 backdrop-blur-sm
               border border-white/30 rounded-xl text-white text-xl font-bold
               hover:bg-white/20 hover:scale-105 transition-all duration-300"
               href="{{ path('app_cookingRecipe_editCookingRecipe', {id: cookingRecipe.id}) }}">
                Update Recipe
            </a>

            <h1 class="text-3xl md:text-4xl font-bold">
                {{ cookingRecipe.recipeName }}
            </h1>

        </div>

        <h2 class="text-2xl md:text-3xl mb-4">
            Ingrediences
        </h2>

        <ul class="mb-8 list-disc list-inside text-left">
            {% for oneIngredience in cookingRecipe.ingredience %}
                <li>{{ oneIngredience }}</li>
            {% endfor %}
        </ul>

        <h2 class="text-2xl md:text-3xl mb-4">
            Cooking process
        </h2>

        <p class="max-w-2xl">
            {{ cookingRecipe.cookingProcess }}
        </p>

    </div>
{% endblock %}
