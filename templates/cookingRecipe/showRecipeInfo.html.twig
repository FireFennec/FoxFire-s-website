{% extends 'base.html.twig' %}

{% block title %}Recipe - cooking.recipeName{% endblock %}

{% block body %}
    <div>
        <div>
            <a href="{{ path('app_cookingRecipe_editCookingRecipe', {id: cookingRecipe.id}) }}">
                Update Recipe
            </a>

            <a href="{{ path('app_cooking_recipe') }}">
                Back
            </a>

            <h1>
                {{ cookingRecipe.recipeName }}
            </h1>
        </div>

        <h2>
            Ingrediences
        </h2>

        <ul>
            {% for oneIngredience in cookingRecipe.ingredience %}
                <li>{{ oneIngredience }}</li>
            {% endfor %}
        </ul>

        <h2>
            Cooking process
        </h2>

        <p>
            {{ cookingRecipe.cookingProcess }}
        </p>
    </div>
{% endblock %}
