<script>
    (() => {
        function initializeIngredients() {
            const ingredientsList = document.getElementById('ingredients-list');
            const addIngredientButton = document.getElementById('add-ingredient');

            if (!ingredientsList || !addIngredientButton) {
                return;
            }

            // Prevent duplicate event listeners.
            if (ingredientsList.dataset.initialized === 'true') {
                return;
            }

            ingredientsList.dataset.initialized = 'true';

            function addIngredient() {
                const index = Number(ingredientsList.dataset.index);
                const prototype = ingredientsList.dataset.prototype;

                ingredientsList.dataset.index = index + 1;

                // Create the same structure used by existing ingredients.
                const wrapper = document.createElement('div');
                wrapper.classList.add('ingredient-entry');

                const ingredientItem = document.createElement('div');
                ingredientItem.classList.add('ingredient-item');

                const inputWrapper = document.createElement('template');
                inputWrapper.innerHTML = prototype.replace(/__name__/g, index);

                const input = inputWrapper.content.firstElementChild;

                if (!input) {
                    return;
                }

                input.setAttribute('aria-label', 'Ingredient');

                const removeButton = document.createElement('button');
                removeButton.type = 'button';
                removeButton.classList.add('remove-ingredient');
                removeButton.setAttribute('aria-label', 'Remove ingredient');
                removeButton.textContent = 'X';

                ingredientItem.appendChild(input);
                ingredientItem.appendChild(removeButton);
                wrapper.appendChild(ingredientItem);

                ingredientsList.appendChild(wrapper);

                // Focus the newly created ingredient field.
                input.focus();
            }

            // Add a new ingredient.
            addIngredientButton.addEventListener('click', addIngredient);

            // Remove ingredients using event delegation.
            ingredientsList.addEventListener('click', (event) => {
                const button = event.target.closest('.remove-ingredient');

                if (!button || !ingredientsList.contains(button)) {
                    return;
                }

                const entry = button.closest('.ingredient-entry');

                if (entry) {
                    entry.remove();
                    addIngredientButton.focus();
                }
            });

            // Create the first ingredient field when the list is empty.
            if (ingredientsList.children.length === 0) {
                addIngredient();
            }
        }

        // Initialize on regular page loads and Turbo navigation.
        document.addEventListener('turbo:load', initializeIngredients);
        initializeIngredients();
    })();
</script>
