{% extends 'base.html.twig' %}

{% block title %}Feature - {{ feature.name }}{% endblock %}

{% block body %}
    <div>
        <div>
            <a href="{{ path('app_FeaturesList_featureListMenu') }}">
                Back
            </a>
        </div>

        <div>
            <div>
                <h1>
                    {{ feature.name }}
                </h1>

                {% if feature.deadlineAt %}
                    <div>
                        <p>
                            Priority: {{ feature.getPriorityString }}
                        </p>
                        <p>
                            Deadline: {{ feature.deadlineAt|ago }}
                        </p>
                    </div>
                {% else %}
                    <div>
                        <p>
                            Priority: {{ feature.getPriorityString }}
                        </p>
                    </div>
                {% endif %}

                <p>
                    {{ feature.description }}
                </p>
            </div>

            <div>
                <a href="{{ path('app_featureList_editFeature', {id: feature.id}) }}">
                    Edit
                </a>

                <a href="{{ path('app_featureDelete', {id: feature.id}) }}">
                    Delete
                </a>
            </div>
        </div>

        <div>
            {{ feature.getStatusString }}
        </div>
    </div>
{% endblock %}
