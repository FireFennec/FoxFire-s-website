{% extends 'base.html.twig' %}

{% block title %}Feature - {{ feature.name }}{% endblock %}

{% block body %}
    <div class="my-4 px-8">
        <div class="flex items-center justify-between">
            <a class="bg-orange-500 hover:bg-orange-600 rounded-xl px-8 py-4 text-white"
               href="{{ path('app_featureList_featureList') }}">
                Back
            </a>

            <span class="bg-orange-500 text-white px-5 py-2 rounded-full
                     text-base md:text-lg font-semibold shadow">
                {{ feature.getStatusString }}
            </span>
        </div>

        <div class="flex justify-center mt-8">
            <div class="text-center text-white w-full max-w-4xl">
                <h2 class="text-3xl md:text-4xl font-bold">
                    {{ feature.name }}
                </h2>

                {% if feature.deadlineAt %}
                    <div class="flex justify-center items-center gap-6 mt-4">
                        <p class="text-xl md:text-2xl lg:text-2xl {{ feature.getPriorityColor }}">
                            Priority: {{ feature.getPriorityString }}
                        </p>
                        <p class="text-xl md:text-2xl lg:text-2xl">
                            Deadline: {{ feature.deadlineAt|ago }}
                        </p>
                    </div>
                {% else %}
                    <div class="flex justify-center items-center gap-6 mt-4">
                        <p class="text-xl md:text-2xl lg:text-2xl {{ feature.getPriorityColor }}">
                            Priority: {{ feature.getPriorityString }}
                        </p>
                    </div>
                {% endif %}

                <p class="text-lg md:text-xl mt-6">
                    {{ feature.description }}
                </p>
            </div>
            <div>
                <a class="ml-4 px-7 py-3 text-xl bg-white/10 backdrop-blur-sm border-2 border-white/30
                   text-white text-lg font-bold
                   hover:bg-white/20 hover:border-white/50
                   hover:scale-105 hover:shadow-xl transition-all duration-300 whitespace-nowrap"
                    href="{{ path('app_featureEdit_editFeature', {id: feature.id}) }}">
                    Edit
                </a>
                <a class="ml-4 px-7 py-3 text-xl bg-white/10 backdrop-blur-sm border-2 border-white/30
                   text-white text-lg font-bold
                   hover:bg-white/20 hover:border-white/50
                   hover:scale-105 hover:shadow-xl transition-all duration-300 whitespace-nowrap"
                   href="{{ path('app_featureDelete', {id: feature.id}) }}">
                    Delete
                </a>
            </div>
        </div>
    </div>
{% endblock %}

