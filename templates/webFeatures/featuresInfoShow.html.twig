{% extends 'base.html.twig' %}

{% block title %}Feature - {{ feature.name }}{% endblock %}

{% block body %}
    {# Main layout for the feature detail page. #}
    <div class="page-layout feature-form-page">

        {# Navigation button to return to the feature list. #}
        <a class="button page-action"
           href="{{ path('app_FeaturesList_featureListMenu') }}">
            Back
        </a>

        {# Main content container displaying feature information. #}
        <div class="page-content page-width-900">
            <section class="page-panel page-panel-standard feature-form-panel">

                {# Display the feature name as the page heading. #}
                <h1>{{ feature.name }}</h1>

                {# Display the current status and priority of the feature. #}
                <div class="feature-detail-overview">
                    <div class="feature-detail-info">
                        <span class="feature-detail-label">Status</span>

                        <span class="feature-badge feature-status-badge">
                            {{ feature.getStatusString }}
                        </span>
                    </div>

                    <div class="feature-detail-info">
                        <span class="feature-detail-label">Priority</span>

                        <span class="feature-badge feature-priority-badge">
                            {{ feature.getPriorityString }}
                        </span>
                    </div>
                </div>

                {# Display the relative deadline if one is set. #}
                {% if feature.deadlineAt %}
                    <div class="feature-detail-text-section">
                        <span class="feature-detail-text-label">Deadline</span>

                        <p class="feature-detail-deadline-value">
                            {{ feature.deadlineAt|ago }}
                        </p>
                    </div>
                {% endif %}

                {# Display the feature description. #}
                <div class="feature-detail-text-section">
                    <span class="feature-detail-text-label">Description</span>

                    <p class="feature-detail-description-value">
                        {{ feature.description }}
                    </p>
                </div>

                {# Include the reusable edit and delete actions. #}
                {{ include('webFeatures/_featureActions.html.twig', {
                    feature: feature
                }, with_context = false) }}

            </section>
        </div>

    </div>
{% endblock %}
