{% extends 'base.html.twig' %}

{% block title %}Feature - {{ feature.name }}{% endblock %}

{% block body %}
    <div class="my-4 px-8">
        <div class="flex items-center justify-between">
            <a class="bg-orange-500 hover:bg-orange-600 rounded-xl px-4 py-2 text-white"
               href="{{ path('app_mainMenu') }}">
                Back
            </a>

            <span class="bg-orange-500 text-white px-5 py-2 rounded-full
                     text-base md:text-lg font-semibold shadow">
                {{ feature.getStatusString }}
            </span>
        </div>

        <div class="flex justify-center mt-8">
            <div class="text-center text-white w-full max-w-4xl">
                <h2 class="text-3xl md:text-4xl font-bold">
                    {{ feature.name }}
                </h2>

                {% if feature.deadlineAt %}
                    <div class="flex justify-center items-center gap-6 mt-4">
                        <p class="text-xl md:text-2xl lg:text-2xl {{ feature.getPriorityColor }}">
                            Priority: {{ feature.getPriorityString }}
                        </p>
                        <p class="text-xl md:text-2xl lg:text-2xl">
                            Deadline: {{ feature.deadlineAt|ago }}
                        </p>
                    </div>
                {% else %}
                    <div class="flex justify-center items-center gap-6 mt-4">
                        <p class="text-xl md:text-2xl lg:text-2xl {{ feature.getPriorityColor }}">
                            Priority: {{ feature.getPriorityString }}
                        </p>
                    </div>
                {% endif %}

                <p class="text-lg md:text-xl mt-6">
                    {{ feature.description }}
                </p>
            </div>
        </div>
    </div>
{% endblock %}

