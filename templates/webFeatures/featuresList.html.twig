{% extends 'base.html.twig' %}

{% block title %}Features list{% endblock %}

{% block body %}
    <div class="flex justify-center mt-10">
        <div class="w-full max-w-xl">
            <h2 class="text-4xl font-bold text-white underline mb-3 w-2/3 mx-auto text-center">
                To do futures
            </h2>
            {% for toDoFeature in toDoFeatures %}
                <a
                    class="block w-2/3 mx-auto border border-gray-600 rounded-md px-4 py-2 mb-2
                   text-center
                   hover:bg-gray-800 hover:text-slate-200 transition
                   {{ toDoFeature.priorityColor() }}"
                    href="{{ path('app_featureList_featureInfoShow', {id: toDoFeature.id}) }}"
                >
                    <strong>{{ toDoFeature.name }}</strong>
                </a>
            {% endfor %}

            <h2 class="text-4xl font-bold text-white underline mt-6 mb-3 w-2/3 mx-auto text-center">
                Completed features
            </h2>
            {% for completedFeature in completedFeatures %}
                <a
                    class="block w-2/3 mx-auto border border-gray-600 rounded-md px-4 py-2 mb-2
               text-center
               hover:bg-gray-800 hover:text-slate-200 transition
               {{ completedFeature.priorityColor() }}"
                    href="{{ path('app_featureList_featureInfoShow', {id: completedFeature.id}) }}"
                >
                    <strong>{{ completedFeature.name }}</strong>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock %}

