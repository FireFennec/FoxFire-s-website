{% extends 'base.html.twig' %}

{% block title %}Edit Feature{% endblock %}

{% block body %}
    <div class="page-layout feature-form-page">
        <a class="button page-action"
            href="{{ path('app_FeaturesList_featureListMenu') }}">
            Back
        </a>

        <div class="page-content page-width-900">
            <section class="page-panel page-panel-standard feature-form-panel">

                <h1>Edit Feature</h1>

                {% include 'webFeatures/_featureForm.html.twig' with {
                    submitLabel: 'Save Changes'
                } %}

            </section>
        </div>
    </div>
{% endblock %}
