{% extends 'base.html.twig' %}

{% block title %}Edit Feature{% endblock %}

{% block body %}
    <div class="feature-form-page">

        <a
            class="button feature-form-back"
            href="{{ path('app_FeaturesList_featureListMenu') }}"
        >
            Back
        </a>

        <div class="feature-form-content">
            <section class="feature-form-panel">

                <h1>Edit Feature</h1>

                {{ form_start(form, {
                    attr: {
                        class: 'feature-form'
                    }
                }) }}

                <div class="feature-form-field">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="feature-form-field">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="feature-form-row">
                    <div class="feature-form-field">
                        {{ form_label(form.status) }}
                        {{ form_widget(form.status) }}
                        {{ form_errors(form.status) }}
                    </div>

                    <div class="feature-form-field">
                        {{ form_label(form.priority) }}
                        {{ form_widget(form.priority) }}
                        {{ form_errors(form.priority) }}
                    </div>
                </div>

                <div class="feature-form-field">
                    {{ form_label(form.deadlineAt) }}
                    {{ form_widget(form.deadlineAt) }}
                    {{ form_errors(form.deadlineAt) }}
                </div>

                <div class="feature-form-actions">
                    {{ form_widget(form.submit, {
                        label: 'Save Changes',
                        attr: {
                            class: 'button'
                        }
                    }) }}
                </div>

                {{ form_end(form) }}

            </section>
        </div>
    </div>
{% endblock %}
