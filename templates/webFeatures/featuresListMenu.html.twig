{% extends 'base.html.twig' %}

{% block title %}Features list{% endblock %}

{% block body %}
    <div class="page-layout features-page">
        <a
            class="button page-action"
            href="{{ path('app_featureList_createFeature') }}"
        >
            + Create Feature
        </a>

        <div class="page-content page-width-1100">
            <section class="page-panel page-panel-compact features-section">
                <h2>To Do Features</h2>

                {% for feature in toDoFeatures %}
                    {% include 'webFeatures/_featureRow.html.twig' %}
                {% endfor %}
            </section>

            <section class="page-panel page-panel-compact features-section">
                <h2>Completed Features</h2>

                {% for feature in completedFeatures %}
                    {% include 'webFeatures/_featureRow.html.twig' %}
                {% endfor %}
            </section>
        </div>
    </div>
{% endblock %}
