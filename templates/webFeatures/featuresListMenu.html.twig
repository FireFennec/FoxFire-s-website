{% extends 'base.html.twig' %}

{% block title %}Features list{% endblock %}

{% block body %}
    <div class="flex justify-center relative m-7">
        <div class="flex-1">
            <a class="casual-button"
               href="{{ path('app_featureList_createFeature') }}">
                Create Feature
            </a>
        </div>

        <div class="justify-center flex-2">
            <div class="max-w-xl">
                <h2 class="text-4xl font-bold text-white mb-6 text-center">
                    To Do Features
                </h2>

                {% for toDoFeature in toDoFeatures %}
                    <div class="flex items-center border border-white/30 px-4 py-2 gap-6 items-center {{ toDoFeature.priorityColor() }}">

                        <a class="flex-1 text-center whitespace-nowrap
                        hover:text-slate-200 hover:scale-110"
                            href="{{ path('app_featureList_featureInfoShow', {id: toDoFeature.id}) }}">
                            <strong>{{ toDoFeature.name }}</strong>
                        </a>

                        <div class="flex gap-2">
                            <a class="px-3 py-1 bg-yellow-500/20 border-2 border-yellow-300/40 text-white text-lg
                            hover:bg-yellow-500/40 hover:border-yellow-300/60"
                               href="{{ path('app_featureList_editFeature', {id: toDoFeature.id}) }}">
                                Edit
                            </a>
                            <a class="px-3 py-1 bg-red-500/20 border-2 border-red-300/40 text-white text-lg
                            hover:bg-red-500/40 hover:border-red-300/60"
                               href="{{ path('app_featureDelete', {id: toDoFeature.id}) }}">
                                Delete
                            </a>
                        </div>
                    </div>
                {% endfor %}

                <h2 class="text-4xl font-bold text-white mb-6 text-center mt-10">
                    Completed features
                </h2>

                {% for completedFeature in completedFeatures %}
                    <div class="flex items-center border border-white/30 px-4 py-2 gap-6 items-center {{ completedFeature.priorityColor() }}">

                        <a class="flex-1 text-center whitespace-nowrap
                        hover:text-slate-200 hover:scale-110"
                            href="{{ path('app_featureList_featureInfoShow', {id: completedFeature.id}) }}">
                            <strong>{{ completedFeature.name }}</strong>
                        </a>

                        <div class="flex gap-2">
                            <a class="px-3 py-1 bg-yellow-500/20 border-2 border-yellow-300/40 text-white text-lg
                            hover:bg-yellow-500/40 hover:border-yellow-300/60"
                               href="{{ path('app_featureList_editFeature', {id: completedFeature.id}) }}">
                                Edit
                            </a>

                            <a class="px-3 py-1 bg-red-500/20 border-2 border-red-300/40 text-white text-lg
                            hover:bg-red-500/40 hover:border-red-300/60"
                               href="{{ path('app_featureDelete', {id: completedFeature.id}) }}">
                                Delete
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
