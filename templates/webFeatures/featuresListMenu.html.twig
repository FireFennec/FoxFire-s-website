{% extends 'base.html.twig' %}

{% block title %}Features list{% endblock %}

{% block body %}
    <div class="page-layout features-page">
        {% if is_granted('ROLE_SUPER_ADMIN') %}
            <a
                class="button page-action"
                href="{{ path('app_featureList_createFeature') }}"
            >
                + Create Feature
            </a>
        {% endif %}

        <div class="page-content page-width-1100">
            <section class="page-panel page-panel-compact features-section">
                <h2>To Do Features</h2>

                {% for feature in toDoFeatures %}
                    {% include 'webFeatures/_featureRow.html.twig' %}
                {% endfor %}
                {% if toDoFeatures.nbPages > 1 %}
                    <nav class="features-pagination" aria-label="To do features pagination">
                        {% if toDoFeatures.hasPreviousPage %}
                            <a class="button" href="{{ path('app_FeaturesList_featureListMenu', {
                                toDoPage: toDoFeatures.previousPage,
                                completedPage: completedFeatures.currentPage
                            }) }}">← Previous</a>
                        {% endif %}

                        <span class="features-page-indicator">
                            Page {{ toDoFeatures.currentPage }} of {{ toDoFeatures.nbPages }}
                        </span>

                        {% if toDoFeatures.hasNextPage %}
                            <a class="button" href="{{ path('app_FeaturesList_featureListMenu', {
                                toDoPage: toDoFeatures.nextPage,
                                completedPage: completedFeatures.currentPage
                            }) }}">Next →</a>
                        {% endif %}
                    </nav>
                {% endif %}
            </section>

            <section class="page-panel page-panel-compact features-section">
                <h2>Completed Features</h2>

                {% for feature in completedFeatures %}
                    {% include 'webFeatures/_featureRow.html.twig' %}
                {% endfor %}
                {% if completedFeatures.nbPages > 1 %}
                    <nav class="features-pagination" aria-label="Completed features pagination">
                        {% if completedFeatures.hasPreviousPage %}
                            <a class="button" href="{{ path('app_FeaturesList_featureListMenu', {
                                completedPage: completedFeatures.previousPage,
                                toDoPage: toDoFeatures.currentPage
                            }) }}">← Previous</a>
                        {% endif %}

                        <span class="features-page-indicator">
                            Page {{ completedFeatures.currentPage }} of {{ completedFeatures.nbPages }}
                        </span>

                        {% if completedFeatures.hasNextPage %}
                            <a class="button" href="{{ path('app_FeaturesList_featureListMenu', {
                                completedPage: completedFeatures.nextPage,
                                toDoPage: toDoFeatures.currentPage
                            }) }}">Next →</a>
                        {% endif %}
                    </nav>
                {% endif %}
            </section>
        </div>

        {# Decorative sticker positioned outside the feature list panels. #}
        <img
            class="feature-list-sticker"
            src="{{ asset('images/stickers/foxfire-notebook.png') }}"
            alt=""
            aria-hidden="true"
        >
    </div>
{% endblock %}
