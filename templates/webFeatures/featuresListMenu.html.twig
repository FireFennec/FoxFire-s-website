{% extends 'base.html.twig' %}

{% block title %}Features list{% endblock %}

{% block body %}
    <div>
        <div>
            <a href="{{ path('app_featureList_createFeature') }}">
                Create Feature
            </a>
        </div>

        <div>
            <div>
                <h2>
                    To Do Features
                </h2>

                {% for toDoFeature in toDoFeatures %}
                    <div>
                        <a href="{{ path('app_FeatureList_featureInfoShow', {id: toDoFeature.id}) }}">
                            <strong>{{ toDoFeature.name }}</strong>
                        </a>

                        <div>
                            <a href="{{ path('app_featureList_editFeature', {id: toDoFeature.id}) }}">
                                Edit
                            </a>

                            <a href="{{ path('app_featureDelete', {id: toDoFeature.id}) }}">
                                Delete
                            </a>
                        </div>
                    </div>
                {% endfor %}

                <h2>
                    Completed features
                </h2>

                {% for completedFeature in completedFeatures %}
                    <div>
                        <a href="{{ path('app_FeatureList_featureInfoShow', {id: completedFeature.id}) }}">
                            <strong>{{ completedFeature.name }}</strong>
                        </a>

                        <div>
                            <a href="{{ path('app_featureList_editFeature', {id: completedFeature.id}) }}">
                                Edit
                            </a>

                            <a href="{{ path('app_featureDelete', {id: completedFeature.id}) }}">
                                Delete
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
