<aside class="pb-8 lg:pb-0 lg:w-[350px] shrink-0 lg:block lg:min-h-screen text-white transition-all overflow-hidden px-8 border-b lg:border-b-0 lg:border-r border-white/20">
    <div class="flex justify-between mt-11 mb-7">
        <a href="{{ path('app_FeaturesList_featureListMenu') }}"
           class="px-6 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30
                                  rounded-full text-white text-lg font-bold hover:bg-white/20 hover:border-white/50
                                  hover:scale-105 hover:shadow-xl transition-all duration-300 whitespace-nowrap flex-shrink-0">
            My Website features list
        </a>
    </div>

    <div>
        <div class="flex flex-col mt-4">
            <strong class="text-2xl">To create: {{ newFeatures|length }} features</strong>
            {% for newFeature in newFeatures %}
                <a
                    class="hover:text-slate-200 {{ newFeature.priorityColor() }}"
                    href="{{ path('app_featureList_featureInfoShow', {id: newFeature.id}) }}"
                ><strong>{{ newFeature.name }}</strong></a>
            {% endfor %}<br>

            <strong class="text-2xl">To update: {{ updateFeatures|length }} features</strong>
            {% for updateFeature in updateFeatures %}
                <a
                    class="hover:text-slate-200 {{ updateFeature.priorityColor() }}"
                    href="{{ path('app_featureList_featureInfoShow', {id: updateFeature.id}) }}"
                ><strong>{{ updateFeature.name }}</strong></a>
            {% endfor %}<br>

            <strong class="text-2xl">Completed: {{ completedFeatures|length }} features</strong>
            {% for completedFeature in completedFeatures %}
            <a
                class="hover:text-slate-200 {{ completedFeature.priorityColor() }}"
                href="{{ path('app_featureList_featureInfoShow', {id: completedFeature.id}) }}"
            ><strong>{{ completedFeature.name }}</strong></a>
            {% endfor %}<br>
        </div>
    </div>
</aside>
