{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Homepage{% endblock %}

{% block body %}
    <div class="homepage-layout">
        {# Aside bar with features list. #}
        {{ include('main/_featuresListAside.html.twig') }}

        <div class="homepage-content">
            <h1>
                FoxFire's website
            </h1>

            <h2>What is the purpose?</h2>
                <p>I want to test my web developing skill here by creating an interesting apps that can be also useful.</p>

            <h2>The plan of things I want to add</h2>
                <strong>Right now there is {{ newFeatures|length }} features to finish in "add new" section.</strong>
                <p>
                    {# List of new planned features. #}
                    {% for newFeature in newFeatures %}
                        <strong>{{ newFeature.name }}</strong>: {{ newFeature.description }}
                        <br>
                    {% endfor %}
                </p>

            <h2>The plan of things I want to update</h2>
                <strong>Right now there is {{ updateFeatures|length }} features to finish in "update" section.</strong>
                <p>
                    {# List of features for the future update. #}
                    {% for updateFeature in updateFeatures %}
                        <strong>{{ updateFeature.name }}</strong>: {{ updateFeature.description }}
                        <br>
                    {% endfor %}
                </p>

            <h2>The list of existing thing here</h2>
            <strong>Right now there is {{ completedFeatures|length }} features in "completed" section.</strong>
            <p>
                {# List of completed features. #}
                {% for completedFeature in completedFeatures %}
                    <strong>{{ completedFeature.name }}</strong>: {{ completedFeature.description }}
                    <br>
                {% endfor %}
            </p>
        </div>
    </div>
{% endblock %}
