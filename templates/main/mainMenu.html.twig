{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Homepage{% endblock %}

{% block body %}
    <div class="homepage-layout">
        {{ include('main/_featuresListAside.html.twig') }}

        <div class="homepage-content">
            <h1>FoxFire's website</h1>

            <h2>What is the purpose?</h2>
            <p>
                I want to improve my web development skills by creating
                interesting and useful applications.
            </p>

            {# Pass only explicitly defined variables to the reusable feature sections. #}
            {{ include('main/_featureSection.html.twig', {
                heading: 'The plan of things I want to add',
                description: 'There are currently ' ~ (newFeatures|length) ~ ' features planned in the "add new" section.',
                features: newFeatures,
                emptyMessage: 'No new features planned.'
            }, with_context = false) }}

            {{ include('main/_featureSection.html.twig', {
                heading: 'The plan of things I want to update',
                description: 'There are currently ' ~ (updateFeatures|length) ~ ' features planned for updates.',
                features: updateFeatures,
                emptyMessage: 'No features are currently planned for updates.'
            }, with_context = false) }}

            {{ include('main/_featureSection.html.twig', {
                heading: 'The list of existing features',
                description: 'There are currently ' ~ completedFeaturesCount ~ ' completed features.',
                features: completedFeatures,
                emptyMessage: 'No features have been completed yet.'
            }, with_context = false) }}
        </div>
    </div>
{% endblock %}
