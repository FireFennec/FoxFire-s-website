{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}Homepage{% endblock %}

{% block body %}
    <h1>FoxFire's website</h1>

    <h3>What is the purpose?</h3>
    <p>I want to test my web developing skill here by creating an interesting apps that can be also useful.</p>

    <h3>The list of existing thing here</h3>
    {% for completedFeature in completedFeatures %}
        <strong>{{ completedFeature.title }}</strong>: {{ completedFeature.description }}<br>
    {% endfor %}

    <h3>The plan of things I want to add</h3>
    {% for newFeature in newFeatures %}
        <strong>{{ newFeature.title }}</strong>: {{ newFeature.description }}<br>
    {% endfor %}

    <h3>The plan of things I want to update</h3>
    {% for updateFeature in updateFeatures %}
        <strong>{{ updateFeature.title }}</strong>: {{ updateFeature.description }}<br>
    {% endfor %}
{% endblock %}
