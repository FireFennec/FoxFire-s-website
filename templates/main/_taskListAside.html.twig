<aside class="pb-8 lg:pb-0 lg:w-[350px] shrink-0 lg:block lg:min-h-screen text-white transition-all overflow-hidden px-8 border-b lg:border-b-0 lg:border-r border-white/20">
    <div class="flex justify-between mt-11 mb-7">
        <h2 class="text-[32px] font-semibold">My tasks list</h2>
    </div>

    <div>
        <div class="flex flex-col mt-4">
            <strong class="text-2xl">Completed: {{ completedFeatures|length }} tasks</strong>
            {% for completedFeature in completedFeatures %}
            <strong>{{ completedFeature.title }}</strong><br>
            {% endfor %}<br>

            <strong class="text-2xl">To create: {{ newFeatures|length }} tasks</strong>
            {% for newFeature in newFeatures %}
            <strong>{{ newFeature.title }}</strong>
            {% endfor %}<br>

            <strong class="text-2xl">To update: {{ updateFeatures|length }} tasks</strong>
            {% for updateFeature in updateFeatures %}
                <strong>{{ updateFeature.title }}</strong><br>
            {% endfor %}
        </div>
    </div>
</aside>
