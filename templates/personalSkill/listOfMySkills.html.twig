{% extends 'base.html.twig' %}

{% block title %}List of my skills{% endblock %}

{% block body %}
    <div class="flex flex-col items-center justify-start pt-15 p-8 text-white">
        <div class="w-full max-w-6xl border-4 border-white rounded-lg p-12">
            <h1 class="text-4xl text-white mb-12 text-center">My personal skills</h1>

            <table class="w-full text-white table-auto border-collapse">
                {% for skill in skills %}
                    <tr class="hover:bg-white/10 rounded-xl transition-colors border-t-4 border-white/30 pt-8 mt-8 pb-4">
                        <td class="py-8 px-12 text-2xl font-bold">{{ skill.skillName }}</td>
                        <td class="py-8 px-12 text-lg leading-relaxed max-w-2xl">{{ skill.skillDescription }}</td>
                        <td class="py-8 px-12 text-2xl font-black text-right">{{ skill.getLevelOfSkillString }}</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
