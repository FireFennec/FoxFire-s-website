{% extends 'base.html.twig' %}

{% block title %}List of my skills{% endblock %}

{% block body %}
    <div>
        <div>
            <h1>My personal skills</h1>

            <table>
                {% for skill in skills %}
                    <tr>
                        <td>{{ skill.skillName }}</td>
                        <td>{{ skill.skillDescription }}</td>
                        <td>{{ skill.getLevelOfSkillString }}</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
