{% extends 'base.html.twig' %}

{% block title %}List of my skills{% endblock %}

{% block body %}
    <div class="page-layout skills-page">
        {% if is_granted('ROLE_PERSONAL_SKILL_ADMIN') %}
            <a
                class="button page-action"
                href="{{ path('app_personal_skill_create') }}"
            >
                + Create Skill
            </a>
        {% endif %}

        <div class="page-content page-width-1000">
            <h1>My personal skills</h1>

            <div class="skills-list">
                {% for skill in skills %}
                    <article class="page-panel page-panel-compact skill-card">
                        <div class="skill-header">
                            <h2 class="skill-name">
                                {{ skill.skillName }}
                            </h2>

                            <span class="skill-level">
                                {{ skill.levelOfSkill.displayLabel }}
                            </span>
                        </div>

                        {% if skill.shortDescription %}
                            <div class="skill-description-container">
                                <p class="skill-description skill-description-short">
                                    {{ skill.shortDescription }}
                                </p>

                                <p class="skill-description skill-description-long" hidden>
                                    {{ skill.skillDescription }}
                                </p>

                                <button type="button" class="skill-description-toggle"
                                        aria-expanded="false">
                                    Read more
                                </button>
                            </div>
                        {% else %}
                            <p class="skill-description">{{ skill.skillDescription }}</p>
                        {% endif %}

                        {% if is_granted('ROLE_PERSONAL_SKILL_ADMIN') %}
                            <div class="form-actions">
                                <a
                                    href="{{ path('app_personal_skill_edit', {
                                        id: skill.id
                                    }) }}"
                                    class="button"
                                >
                                    Edit
                                </a>
                            </div>
                        {% endif %}
                    </article>
                {% else %}
                    <div class="page-panel page-panel-compact skills-empty">
                        <p>No skills available yet.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
