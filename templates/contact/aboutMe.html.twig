{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}About me{% endblock %}

{% block body %}
    <h1>About me</h1>
    <table>
        <tr>
            <h3>Contact me</h3>
        </tr>
        <tr>
            <td><strong>Email:</strong> {{ myContactInformation.0.email }}</td>
        </tr>
        <tr>
            <td><strong>Telegram:</strong> {{ myContactInformation.0.telegram }}</td>
        </tr>
        <tr>
            <td><strong>Discord:</strong> {{ myContactInformation.0.discord }}</td>
        </tr>
    </table>

    <table>
        <tr>
            <h3>Follow me</h3>
        </tr>
        <tr>
            <td><strong>X:</strong> {{ myContactInformation.0.x }}</td>
        </tr>
        <tr>
            <td><strong>X(AD):</strong> {{ myContactInformation.0.xAd }}</td>
        </tr>
        <tr>
            <td><strong>Barq:</strong> {{ myContactInformation.0.barq }}</td>
        </tr>
    </table>
{% endblock %}
