{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}About me{% endblock %}

{% block body %}
    <div>
        <div>
            <h1>About me</h1>

            <table>
                <tr>
                    <th>Contact me</th>
                </tr>
                <tr>
                    <td><strong>Email:</strong> {{ myContactInformation.email }}</td>
                </tr>
                <tr>
                    <td>
                        <strong>Telegram:</strong>
                        <a href="https://t.me/{{ myContactInformation.telegram }}">
                            {{ myContactInformation.telegram }}
                        </a>
                    </td>
                </tr>
                <tr>
                    <td><strong>Discord:</strong> {{ myContactInformation.discord }}</td>
                </tr>
                <tr>
                    <td><strong>Phone number:</strong> {{ myContactInformation.phoneNumber }}</td>
                </tr>
            </table>

            <table>
                <tr>
                    <th>Follow me</th>
                </tr>
                <tr>
                    <td>
                        <strong>X:</strong>
                        {% if myContactInformation.xLink %}
                            <a href="{{ myContactInformation.xLink }}">
                                {{ myContactInformation.x }} - (Link)
                            </a>
                        {% else %}
                            {{ myContactInformation.x }}
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>Barq:</strong>
                        {% if myContactInformation.BarqLink %}
                            <a href="{{ myContactInformation.BarqLink }}">
                                {{ myContactInformation.barq }} - (Link)
                            </a>
                        {% else %}
                            {{ myContactInformation.barq }}
                        {% endif %}
                    </td>
                </tr>
            </table>
        </div>
    </div>
{% endblock %}
