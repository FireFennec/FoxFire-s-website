{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}About me{% endblock %}

{% block body %}
    <h1 class="text-4xl">About me</h1>
    <table>
        <tr>
            <h3 class="text-3xl">Contact me</h3>
        </tr>
        <tr>
            <td><strong>Email:</strong> {{ myContactInformation.email }}</td>
        </tr>
        <tr>
            <td><strong>Telegram:</strong>
                <a href="https://t.me/{{ myContactInformation.telegram }}">
                    {{ myContactInformation.telegram }}
                </a></td>
        </tr>
        <tr>
            <td><strong>Discord:</strong> {{ myContactInformation.discord }}</td>
        </tr>
    </table><br>

    <table>
        <tr>
            <h3>Follow me</h3>
        </tr>
        <tr>
            <td><strong>X:</strong>
                {% if myContactInformation.xLink %}
                    <a href="{{ myContactInformation.xLink }}">{{ myContactInformation.x }}</a>
                {% else %}
                    {{ myContactInformation.x }}
                {% endif %}
            </td>
        </tr>
        <tr>
            <td><strong>X(AD):</strong>
                {% if myContactInformation.xAdLink %}
                    <a href="{{ myContactInformation.xAdLink }}">{{ myContactInformation.xAd }}</a>
                {% else %}
                    {{ myContactInformation.xAd }}
                {% endif %}
            </td>
        </tr>
        <tr>
            <td><strong>Barq:</strong>
                {% if myContactInformation.BarqLink %}
                    <a href="{{ myContactInformation.BarqLink }}">{{ myContactInformation.barq }}</a>
                {% else %}
                    {{ myContactInformation.barq }}
                {% endif %}
            </td>
        </tr>
    </table>
{% endblock %}
