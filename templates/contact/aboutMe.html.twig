{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}About me{% endblock %}

{% block body %}
    {# Main layout for the About Me page. #}
    <div class="page-layout-simple about-page">

        <div class="page-content-simple page-width-900">
            <h1>About me</h1>

            <div class="page-panel page-panel-standard">

                {# CONTACT INFORMATION #}
                {# Direct contact methods. #}
                <section class="about-section">
                    <h2>Contact me</h2>

                    {# Email address. #}
                    {% if myContactInformation.email %}
                        <div class="about-row">
                            <span class="about-label">Email</span>

                            <span class="about-value">
                                {{ myContactInformation.email }}
                            </span>
                        </div>
                    {% endif %}

                    {# Telegram username and profile link. #}
                    {% if myContactInformation.telegram %}
                        <div class="about-row">
                            <span class="about-label">Telegram</span>

                            <span class="about-value">
                                {{ myContactInformation.telegram }}
                            </span>

                            <a
                                class="about-link"
                                href="https://t.me/{{ myContactInformation.telegram|url_encode }}"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Open ↗
                            </a>
                        </div>
                    {% endif %}

                    {# Discord username. #}
                    {% if myContactInformation.discord %}
                        <div class="about-row">
                            <span class="about-label">Discord</span>

                            <span class="about-value">
                                {{ myContactInformation.discord }}
                            </span>
                        </div>
                    {% endif %}

                    {# Phone number. #}
                    {% if myContactInformation.phoneNumber %}
                        <div class="about-row">
                            <span class="about-label">Phone</span>

                            <span class="about-value">
                                {{ myContactInformation.phoneNumber }}
                            </span>
                        </div>
                    {% endif %}
                </section>

                {# SOCIAL MEDIA #}
                {# Social media profiles with optional external links. #}
                <section class="about-section">
                    <h2>Follow me</h2>

                    {# X (formerly Twitter) profile. #}
                    {% if myContactInformation.x %}
                        <div class="about-row">
                            <span class="about-label">X</span>

                            <span class="about-value">
                                {{ myContactInformation.x }}
                            </span>

                            {% if myContactInformation.xLink %}
                                <a
                                    class="about-link"
                                    href="{{ myContactInformation.xLink }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Open ↗
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# Barq profile. #}
                    {% if myContactInformation.barq %}
                        <div class="about-row">
                            <span class="about-label">Barq</span>

                            <span class="about-value">
                                {{ myContactInformation.barq }}
                            </span>

                            {% if myContactInformation.barqLink %}
                                <a
                                    class="about-link"
                                    href="{{ myContactInformation.barqLink }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Open ↗
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                </section>

                {# OTHER PLATFORMS #}
                {# Gaming platforms and account information. #}
                <section class="about-section">
                    <h2>Other platforms</h2>

                    {# Steam profile with an optional external link. #}
                    {% if myContactInformation.steam %}
                        <div class="about-row">
                            <span class="about-label">Steam</span>

                            <span class="about-value">
                                {{ myContactInformation.steam }}
                            </span>

                            {% if myContactInformation.steamLink %}
                                <a
                                    class="about-link"
                                    href="{{ myContactInformation.steamLink }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Open ↗
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# Battle.net BattleTag. #}
                    {% if myContactInformation.battleNet %}
                        <div class="about-row">
                            <span class="about-label">Battle.net</span>

                            <span class="about-value">
                                {{ myContactInformation.battleNet }}
                            </span>
                        </div>
                    {% endif %}
                </section>

            </div>
        </div>
    </div>
{% endblock %}
