{# Represents a single personal shopping list item. #}
<li
    class="shopping-list-item{% if item.isPurchased %} is-purchased{% endif %}"
    data-item-id="{{ item.id }}"
>
    <form
        class="shopping-list-toggle-form"
        action="{{ path('app_shopping_list_toggle', {id: item.id}) }}"
        method="post"
    >
        <input
            type="hidden"
            name="_token"
            value="{{ csrf_token('shopping_list_toggle_' ~ item.id) }}"
        >

        <label class="shopping-list-item-label">

            <input
                type="checkbox"
                class="shopping-list-checkbox"
                {% if item.isPurchased %}checked{% endif %}
            >

            <span class="shopping-list-item-name">
                {{ item.name }}
            </span>

        </label>
    </form>

    <form
        class="shopping-list-delete-form"
        action="{{ path('app_shopping_list_delete', {id: item.id}) }}"
        method="post"
    >
        <input
            type="hidden"
            name="_token"
            value="{{ csrf_token('shopping_list_delete_' ~ item.id) }}"
        >

        <button
            type="submit"
            class="shopping-list-delete-button"
            aria-label="Delete {{ item.name }}"
            title="Delete product"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M3 6h18"/>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                <line x1="10" y1="11" x2="10" y2="17"/>
                <line x1="14" y1="11" x2="14" y2="17"/>
            </svg>
        </button>
    </form>
</li>
