{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}
    <div class="page-layout account-page change-password-page">
        <a
            class="button page-action"
            href="{{ path('app_account') }}"
        >
            Back
        </a>

        <div class="page-content page-width-800">
            <h1>Change Password</h1>

            <section class="page-panel page-panel-standard">
                {{ form_start(form) }}

                <div class="form-field">
                    {{ form_label(form.currentPassword) }}
                    {{ form_widget(form.currentPassword) }}

                    <div class="form-error">
                        {{ form_errors(form.currentPassword) }}
                    </div>

                    {% if passwordError %}
                        <p class="form-error">
                            {{ passwordError }}
                        </p>
                    {% endif %}
                </div>

                <div class="form-field">
                    {{ form_label(form.newPassword.first) }}
                    {{ form_widget(form.newPassword.first) }}
                </div>

                <div class="form-field">
                    {{ form_label(form.newPassword.second) }}
                    {{ form_widget(form.newPassword.second) }}

                    <div class="form-error">
                        {{ form_errors(form.newPassword.first) }}
                        {{ form_errors(form.newPassword.second) }}
                        {{ form_errors(form.newPassword) }}
                    </div>

                    {% if newPasswordError %}
                        <p class="form-error">
                            {{ newPasswordError }}
                        </p>
                    {% endif %}
                </div>

                <div class="form-error">
                    {{ form_errors(form) }}
                </div>

                <div class="form-actions">
                    <button type="submit" class="button">
                        Change Password
                    </button>
                </div>

                {{ form_end(form) }}
            </section>
        </div>
    </div>
{% endblock %}
